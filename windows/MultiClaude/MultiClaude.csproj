<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Multi Claude</AssemblyName>
    <RootNamespace>MultiClaude</RootNamespace>
    <Version>2.3.0</Version>
    <InformationalVersion>2.3.0-wpf</InformationalVersion>
    <Description>Multi Claude · Modified WPF edition</Description>
    <ApplicationIcon>../../recursos/icone.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Checks" />
    <EmbeddedResource Include="Resources/*.json;Resources/*.ps1" />
    <Content Include="../../profile_pictures/*.png" Link="gallery/%(Filename)%(Extension)" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE;../../NOTICE;../../AUTHORS" Link="%(Filename)%(Extension)" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
